
export module fusion.types;

import std;

export using FsI8 = std::int8_t;
export using FsI16 = std::int16_t;
export using FsI32 = std::int32_t;
export using FsI64 = std::int64_t;

export using FsU8 = std::uint8_t;
export using FsU16 = std::uint16_t;
export using FsU32 = std::uint32_t;
export using FsU64 = std::uint64_t;

export using FsF32 = float;
export using FsF64 = double;

export using FsUsize = std::size_t;

export using FsBool = bool;
